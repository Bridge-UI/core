{
  "private": true,
  "name": "bridge-ui-core",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "deps": "npm install",
    "install:react": "npm install -w @bridge-ui/react",
    "install:vue": "npm install -w @bridge-ui/vue",
    "build": "npm run build -w @bridge-ui/core && npm run build -w @bridge-ui/vue && npm run build -w @bridge-ui/react",
    "build:core": "npm run build -w @bridge-ui/core",
    "build:react": "npm run build -w @bridge-ui/react",
    "build:vue": "npm run build -w @bridge-ui/vue",
    "dev": "npm run dev -w @bridge-ui/vue & npm run dev -w @bridge-ui/react",
    "dev:react": "npm run dev -w @bridge-ui/react",
    "dev:vue": "npm run dev -w @bridge-ui/vue",
    "type-check": "npm run type-check:core && npm run type-check:vue && npm run type-check:react",
    "type-check:core": "npm run type-check -w @bridge-ui/core",
    "type-check:react": "npm run type-check -w @bridge-ui/react",
    "type-check:vue": "npm run type-check -w @bridge-ui/vue",
    "test": "npm run test -w @bridge-ui/core && npm run test -w @bridge-ui/vue && npm run test -w @bridge-ui/react",
    "test:run": "npm run test:run -w @bridge-ui/core && npm run test:run -w @bridge-ui/vue && npm run test:run -w @bridge-ui/react",
    "test:core": "npm run test:run -w @bridge-ui/core",
    "test:react": "npm run test:run -w @bridge-ui/react",
    "test:vue": "npm run test:run -w @bridge-ui/vue",
    "test:cy": "npm run test:cy:vue && npm run test:cy:react",
    "test:cy:react": "npm run test:cy -w @bridge-ui/react",
    "test:cy:vue": "npm run test:cy -w @bridge-ui/vue",
    "lint": "eslint packages/core/src packages/react/src packages/vue/src",
    "lint:fix": "eslint packages/core/src packages/react/src packages/vue/src --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bump-version": "bash scripts/bump-version.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/language-core": "^3.3.11",
    "cypress": "^16.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
