{
  "type": "module",
  "license": "MIT",
  "version": "0.20.0",
  "author": "BridgeUI",
  "sideEffects": false,
  "name": "@bridge-ui/core",
  "homepage": "https://github.com/Bridge-UI/core#readme",
  "description": "Shared types, design tokens, and utilities for Bridge UI.",
  "bugs": {
    "url": "https://github.com/Bridge-UI/core/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "directory": "packages/core",
    "url": "git+https://github.com/Bridge-UI/core.git"
  },
  "keywords": [
    "bridge-ui",
    "utilities",
    "components",
    "typescript",
    "design-system",
    "design-tokens"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Adapters": {
      "import": "./dist/Adapters/index.js",
      "types": "./dist/Adapters/index.d.ts"
    },
    "./Config": {
      "import": "./dist/Config/index.js",
      "types": "./dist/Config/index.d.ts"
    },
    "./Domain": {
      "import": "./dist/Domain/index.js",
      "types": "./dist/Domain/index.d.ts"
    },
    "./Layer": {
      "import": "./dist/Layer/index.js",
      "types": "./dist/Layer/index.d.ts"
    },
    "./Runtime": {
      "import": "./dist/Runtime/index.js",
      "types": "./dist/Runtime/index.d.ts"
    },
    "./Integrations/Echarts": {
      "import": "./dist/Integrations/Echarts/index.js",
      "types": "./dist/Integrations/Echarts/index.d.ts"
    },
    "./Integrations/Tiptap": {
      "import": "./dist/Integrations/Tiptap/index.js",
      "types": "./dist/Integrations/Tiptap/index.d.ts"
    },
    "./Utils": {
      "import": "./dist/Utils/index.js",
      "types": "./dist/Utils/index.d.ts"
    },
    "./Tokens": {
      "import": "./dist/Tokens/index.js",
      "types": "./dist/Tokens/index.d.ts"
    },
    "./utilities.css": {
      "style": "./src/utilities.css",
      "import": "./src/utilities.css",
      "default": "./src/utilities.css"
    }
  },
  "files": [
    "dist",
    "src/utilities.css"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "echarts": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^24.19.1",
    "echarts": "^6.1.0",
    "typescript": "^6.0.3"
  }
}
