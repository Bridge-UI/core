{
  "type": "module",
  "license": "MIT",
  "version": "0.7.0",
  "author": "BridgeUI",
  "sideEffects": false,
  "name": "@bridge-ui/react",
  "homepage": "https://github.com/Bridge-UI/core#readme",
  "description": "React components and hooks for Bridge UI.",
  "bugs": {
    "url": "https://github.com/Bridge-UI/core/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "directory": "packages/react",
    "url": "git+https://github.com/Bridge-UI/core.git"
  },
  "keywords": [
    "ui",
    "react",
    "tailwind",
    "bridge-ui",
    "components",
    "design-system"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Utils": {
      "import": "./dist/Utils/index.js",
      "types": "./dist/Utils/index.d.ts"
    },
    "./Provider": {
      "import": "./dist/Provider/index.js",
      "types": "./dist/Provider/index.d.ts"
    },
    "./Adapters": {
      "import": "./dist/Adapters/index.js",
      "types": "./dist/Adapters/index.d.ts"
    },
    "./Adapters/Icon": {
      "import": "./dist/Adapters/Icon/index.js",
      "types": "./dist/Adapters/Icon/index.d.ts"
    },
    "./Adapters/I18n": {
      "import": "./dist/Adapters/I18n/index.js",
      "types": "./dist/Adapters/I18n/index.d.ts"
    },
    "./Actions": {
      "import": "./dist/Actions/index.js",
      "types": "./dist/Actions/index.d.ts"
    },
    "./Components/*": {
      "import": "./dist/Components/*/index.js",
      "types": "./dist/Components/*/index.d.ts"
    },
    "./theme.css": {
      "style": "./dist/theme.css",
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./ai/*": "./ai/*",
    "./docs/*": "./docs/*"
  },
  "bin": {
    "bridge-ui-react-ai": "./bin/ai.mjs"
  },
  "files": [
    "ai",
    "bin",
    "dist",
    "docs"
  ],
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "dependencies": {
    "@bridge-ui/core": "^0.7.0",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "build": "vite build && cp src/theme.css dist/theme.css",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cy": "cypress run --component",
    "test:cy:open": "cypress open --component"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/react": "^16.3.2",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "lucide-react": "^1.30.0",
    "luxon": "^3.7.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
