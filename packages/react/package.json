{
  "type": "module",
  "license": "MIT",
  "version": "0.15.0",
  "author": "BridgeUI",
  "sideEffects": false,
  "name": "@bridge-ui/react",
  "homepage": "https://github.com/Bridge-UI/core#readme",
  "description": "React components and hooks for Bridge UI.",
  "bugs": {
    "url": "https://github.com/Bridge-UI/core/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "directory": "packages/react",
    "url": "git+https://github.com/Bridge-UI/core.git"
  },
  "keywords": [
    "ui",
    "react",
    "tailwind",
    "bridge-ui",
    "components",
    "design-system"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Utils": {
      "import": "./dist/Utils/index.js",
      "types": "./dist/Utils/index.d.ts"
    },
    "./Provider": {
      "import": "./dist/Provider/index.js",
      "types": "./dist/Provider/index.d.ts"
    },
    "./Adapters": {
      "import": "./dist/Adapters/index.js",
      "types": "./dist/Adapters/index.d.ts"
    },
    "./Adapters/Icon": {
      "import": "./dist/Adapters/Icon/index.js",
      "types": "./dist/Adapters/Icon/index.d.ts"
    },
    "./Adapters/I18n": {
      "import": "./dist/Adapters/I18n/index.js",
      "types": "./dist/Adapters/I18n/index.d.ts"
    },
    "./Actions": {
      "import": "./dist/Actions/index.js",
      "types": "./dist/Actions/index.d.ts"
    },
    "./Components/*": {
      "import": "./dist/Components/*/index.js",
      "types": "./dist/Components/*/index.d.ts"
    },
    "./theme.css": {
      "style": "./dist/theme.css",
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./ai/*": "./ai/*",
    "./docs/*": "./docs/*"
  },
  "bin": {
    "bridge-ui-react-ai": "./bin/ai.mjs"
  },
  "files": [
    "ai",
    "bin",
    "dist",
    "docs"
  ],
  "peerDependencies": {
    "@tanstack/react-table": "^9.2.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "echarts": "^5.0.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "dependencies": {
    "@bridge-ui/core": "^0.15.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "build": "vite build && cp src/theme.css dist/theme.css",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cy": "cypress run --component",
    "test:cy:open": "cypress open --component"
  },
  "devDependencies": {
    "@inertiajs/react": "^3.7.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "echarts": "^6.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
