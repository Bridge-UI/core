{
  "type": "module",
  "private": true,
  "license": "MIT",
  "version": "0.19.0",
  "author": "BridgeUI",
  "sideEffects": [
    "**/*.css"
  ],
  "name": "@bridge-ui/svelte",
  "homepage": "https://github.com/Bridge-UI/core#readme",
  "description": "Svelte components for Bridge UI (spike, not published).",
  "repository": {
    "type": "git",
    "directory": "packages/svelte",
    "url": "git+https://github.com/Bridge-UI/core.git"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "style": "./dist/theme.css",
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@bridge-ui/core": "^0.19.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && find dist -name __tests__ -type d -prune -exec rm -rf {} + && cp src/theme.css dist/theme.css",
    "dev": "svelte-package -i src -o dist --watch",
    "type-check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cy": "cypress run --component",
    "test:cy:open": "cypress open --component"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7"
  }
}
