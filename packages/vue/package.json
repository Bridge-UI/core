      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "quill": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "luxon": {
      "optional": true
    },
    "moment": {
      "optional": true
    },
    "moment-timezone": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    }
  },
  "dependencies": {
    "@bridge-ui/core": "^0.11.0",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "build": "vite build && cp src/theme.css dist/theme.css",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cy": "cypress run --component",
    "test:cy:open": "cypress open --component"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.30.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.13.3",
    "@vue/language-core": "^3.3.9",
    "@vue/test-utils": "^2.4.11",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
