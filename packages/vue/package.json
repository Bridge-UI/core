{
  "type": "module",
  "license": "MIT",
  "version": "0.11.0",
  "author": "BridgeUI",
  "sideEffects": false,
  "name": "@bridge-ui/vue",
  "homepage": "https://github.com/Bridge-UI/core#readme",
  "description": "Vue components and composables for Bridge UI.",
  "bugs": {
    "url": "https://github.com/Bridge-UI/core/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "directory": "packages/vue",
    "url": "git+https://github.com/Bridge-UI/core.git"
  },
  "keywords": [
    "ui",
    "vue",
    "tailwind",
    "bridge-ui",
    "components",
    "design-system"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Utils": {
      "import": "./dist/Utils/index.js",
      "types": "./dist/Utils/index.d.ts"
    },
    "./Provider": {
      "import": "./dist/Provider/index.js",
      "types": "./dist/Provider/index.d.ts"
    },
    "./Adapters": {
      "import": "./dist/Adapters/index.js",
      "types": "./dist/Adapters/index.d.ts"
    },
    "./Adapters/Icon": {
      "import": "./dist/Adapters/Icon/index.js",
      "types": "./dist/Adapters/Icon/index.d.ts"
    },
    "./Adapters/I18n": {
      "import": "./dist/Adapters/I18n/index.js",
      "types": "./dist/Adapters/I18n/index.d.ts"
    },
    "./Adapters/RichText": {
      "import": "./dist/Adapters/RichText/index.js",
      "types": "./dist/Adapters/RichText/index.d.ts"
    },
    "./Adapters/Examples/*": {
      "import": "./dist/Adapters/Examples/*.js",
      "types": "./dist/Adapters/Examples/*.d.ts"
    },
    "./Actions": {
      "import": "./dist/Actions/index.js",
      "types": "./dist/Actions/index.d.ts"
    },
    "./Components/*": {
      "import": "./dist/Components/*/index.js",
      "types": "./dist/Components/*/index.d.ts"
    },
    "./theme.css": {
      "style": "./dist/theme.css",
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./ai/*": "./ai/*",
    "./docs/*": "./docs/*"
  },
  "bin": {
    "bridge-ui-vue-ai": "./bin/ai.mjs"
  },
  "files": [
    "ai",
    "bin",
    "dist",
    "docs"
  ],
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/vue-fontawesome": "^3.0.0",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^0.400.0 || ^1.0.0",
    "@phosphor-icons/vue": "^2.2.0",
    "@tabler/icons-vue": "^3.0.0",
    "@tanstack/vue-table": "^8.21.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "date-fns": "^4.0.0",
    "dayjs": "^1.11.0",
    "luxon": "^3.0.0",
    "moment": "^2.30.0",
    "moment-timezone": "^0.5.0 || ^0.6.0",
    "quill": "^2.0.0",
    "vue": "^3.4.0",
    "vue-i18n": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@fortawesome/fontawesome-svg-core": {
      "optional": true
    },
    "@fortawesome/free-solid-svg-icons": {
      "optional": true
    },
