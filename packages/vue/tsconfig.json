{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@examples/*": ["../../examples/*"]
    }
  },
  "include": ["src", "cypress", "vitest.setup.ts", "env.d.ts"],
  "exclude": ["src/**/__tests__"]
}
